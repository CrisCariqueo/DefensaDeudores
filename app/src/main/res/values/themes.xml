<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real theming (ui/theme/Theme.kt). AppCompat parent is
         required by AppCompatActivity (per-app locale switching below API 33);
         the black window background avoids a white flash on cold start. -->
    <style name="Theme.DefensaDeDeudores" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
